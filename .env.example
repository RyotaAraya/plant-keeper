POSTGRES_USER=manage
POSTGRES_PASSWORD=manage_password
POSTGRES_DB=manage_development
DATABASE_URL=postgres://manage:manage_password@db:5432/manage_development
RAILS_ENV=development
DEVISE_JWT_SECRET_KEY=dev_jwt_secret_key_change_in_production

# AI支援（不具合報告の下書き）。ANTHROPIC_API_KEY を設定するとAPIを呼び、点検フォームにAIのボタンが出る（未設定なら出ない）。
# AI_PROVIDER=fake にするとAPIを呼ばないダミーの下書きを返す（E2E・キーなしの動作確認用）
# ANTHROPIC_API_KEY=sk-ant-...
# AI_PROVIDER=
